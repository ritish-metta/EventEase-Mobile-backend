# ─────────────────────────────────────────────────────────
# EventEase Backend — environment variable template
# Copy this file to `.env` and fill in the real values.
# Never commit the real `.env` to version control.
# ─────────────────────────────────────────────────────────

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB) ---
# MONGODB_URI is accepted as an alias if MONGO_URI is unset.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Cache (Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# --- Email (Nodemailer / Gmail) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-google-app-password

# --- Twilio (SMS / SOS alerts) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# --- Python service (yoga / pose API) ---
PYTHON_API_URL=http://localhost:5001

# --- ePrisons API (releases / prisoner-photo) ---
# Currently hardcoded in routes/release-api.js and routes/photo_copy.js.
# Move them here and read via process.env before deploying.
EPRISONS_USER_ID=your-eprisons-user-id
EPRISONS_PASSWORD=your-eprisons-password
EPRISONS_PRIVATE_KEY=your-16-char-private-key
